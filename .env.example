DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=data_room
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/data_room

APP_PORT=3000
# Hosting platforms such as Render provide PORT automatically.
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_SECRET=change-me-too
JWT_REFRESH_TOKEN_EXPIRATION=7d

# local | supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Required only when STORAGE_DRIVER=supabase. Keep the bucket private and never
# expose the secret key to the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=data-room-files
